# Copy to .env only if you need to change a default. .env is gitignored. Never commit a key.
# Where Munim keeps its database and uploaded papers.
MUNIM_DATA_DIR=./data
# Munim listens on loopback only. Do not change the host unless you understand the risk (README).
MUNIM_HOST=127.0.0.1
MUNIM_PORT=8765
# Reader: ollama (local, default) | gemini (hosted, needs consent and a key) | replay (recorded responses)
MUNIM_PROVIDER=ollama
MUNIM_OLLAMA_URL=http://127.0.0.1:11434
MUNIM_OLLAMA_MODEL=gemma4:e4b
MUNIM_GEMINI_MODEL=gemma-4-31b-it
# Only for the hosted reader. Set it in your shell environment; it is never stored or logged.
GEMINI_API_KEY=
# Interface language: en | hi
MUNIM_LANG=en
